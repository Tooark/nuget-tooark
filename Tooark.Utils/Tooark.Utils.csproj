<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Tooark.Utils</PackageId>
    <Title>Tooark.Utils</Title>
    <Authors>Paulo Sergio de Freitas Junior</Authors>
    <PackageTags>tooark, toolkit, utils, helpers, culture, localization, globalization, normalize, .NET</PackageTags>
    <Summary>Management of general utility functions for .NET projects.</Summary>
    <PackageDescription>General utility package for .NET applications.</PackageDescription>
    <Description>A library of general utility functions that aid development, including methods for manipulating strings, dates, collections, and more.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tooark.Exceptions\Tooark.Exceptions.csproj" />
    <ProjectReference Include="..\Tooark.Validations\Tooark.Validations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      FileConvert e FileValid ainda têm métodos que recebem IFormFile, obsoletos desde a v4.11.0. O tipo vem do
      pacote Microsoft.AspNetCore.Http 2.x, o último publicado fora do framework compartilhado, para o pacote
      continuar utilizável em console, worker e testes sem o Microsoft.AspNetCore.App. Numa aplicação ASP.NET
      Core o SDK resolve o conflito em favor do assembly do framework, e o IFormFile é o mesmo tipo.
      Na v5 esses métodos e esta referência saem: os substitutos por Stream e por nome de arquivo já estão
      aqui, e as extensões de IFormFile, no Tooark.AspNetCore (Tooark.AspNetCore.Files).
    -->
    <PackageReference Include="Microsoft.AspNetCore.Http" />
  </ItemGroup>

</Project>
