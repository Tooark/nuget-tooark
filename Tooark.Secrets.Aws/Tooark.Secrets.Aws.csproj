<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Tooark.Secrets.Aws</PackageId>
    <Title>Tooark.Secrets.Aws</Title>
    <Authors>Paulo Sergio de Freitas Junior</Authors>
    <PackageTags>tooark, toolkit, secrets, aws, secrets manager, parameter store, ssm, configuration, .NET</PackageTags>
    <Summary>AWS Secrets Manager and Parameter Store provider for the Tooark secrets abstractions.</Summary>
    <PackageDescription>Package that loads AWS Secrets Manager secrets and Systems Manager Parameter Store parameters into IConfiguration and implements the Tooark ISecretService on Secrets Manager.</PackageDescription>
    <Description>Library with the AWS provider of Tooark.Secrets: a configuration source for Secrets Manager and Parameter Store, and runtime secret reads with cache, using the AWS default credential chain.</Description>
    <!--
      Pacote novo na v4.7.0: ainda não existe versão publicada para comparar a API. Remova esta linha depois da
      primeira publicação, para que o pacote passe a ser validado contra a baseline do Directory.Build.props.
    -->
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tooark.Secrets\Tooark.Secrets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SecretsManager" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
