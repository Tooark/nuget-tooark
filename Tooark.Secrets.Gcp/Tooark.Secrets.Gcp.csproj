<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Tooark.Secrets.Gcp</PackageId>
    <Title>Tooark.Secrets.Gcp</Title>
    <Authors>Paulo Sergio de Freitas Junior</Authors>
    <PackageTags>tooark, toolkit, secrets, gcp, google cloud, secret manager, parameter manager, configuration, .NET</PackageTags>
    <Summary>Google Cloud Secret Manager and Parameter Manager provider for the Tooark secrets abstractions.</Summary>
    <PackageDescription>Package that loads Google Cloud Secret Manager secrets and Parameter Manager parameters into IConfiguration and implements the Tooark ISecretService on Secret Manager.</PackageDescription>
    <Description>Library with the Google Cloud provider of Tooark.Secrets: a configuration source for Secret Manager and Parameter Manager, and runtime secret reads with cache, using Application Default Credentials.</Description>
    <!--
      Pacote novo na v4.7.0: ainda não existe versão publicada para comparar a API. Remova esta linha depois da
      primeira publicação, para que o pacote passe a ser validado contra a baseline do Directory.Build.props.
    -->
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tooark.Secrets\Tooark.Secrets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.ParameterManager.V1" />
    <PackageReference Include="Google.Cloud.SecretManager.V1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
