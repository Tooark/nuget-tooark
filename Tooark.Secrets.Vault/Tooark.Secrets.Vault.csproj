<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Tooark.Secrets.Vault</PackageId>
    <Title>Tooark.Secrets.Vault</Title>
    <Authors>Paulo Sergio de Freitas Junior</Authors>
    <PackageTags>tooark, toolkit, secrets, vault, hashicorp, openbao, kv, configuration, .NET</PackageTags>
    <Summary>HashiCorp Vault and OpenBao provider for the Tooark secrets abstractions.</Summary>
    <PackageDescription>Package that loads the KV v2 secrets of HashiCorp Vault or OpenBao into IConfiguration and implements the Tooark ISecretService on them, with token, AppRole or Kubernetes authentication.</PackageDescription>
    <Description>Library with the Vault provider of Tooark.Secrets, working with HashiCorp Vault and OpenBao through the KV v2 HTTP API, without a third-party client.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tooark.Secrets\Tooark.Secrets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
