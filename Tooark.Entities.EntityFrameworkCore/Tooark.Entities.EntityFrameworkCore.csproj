<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Tooark.Entities.EntityFrameworkCore</PackageId>
    <Title>Tooark.Entities.EntityFrameworkCore</Title>
    <Authors>Paulo Sergio de Freitas Junior</Authors>
    <PackageTags>tooark, toolkit, entities, entityframeworkcore, audit, softdelete, concurrency, .NET</PackageTags>
    <Summary>Entity Framework Core integration for the Tooark entities: audit stamping, soft delete and concurrency.</Summary>
    <PackageDescription>Library that plugs the Tooark entities into Entity Framework Core: an interceptor that stamps the audit fields and turns Remove() into a soft delete, and model conventions for the soft delete filter and the concurrency token.</PackageDescription>
    <Description>Library that plugs the Tooark entities into Entity Framework Core: an interceptor that stamps the audit fields and turns Remove() into a soft delete, and model conventions for the soft delete filter and the concurrency token.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tooark.Entities\Tooark.Entities.csproj" />
    <ProjectReference Include="..\Tooark.Exceptions\Tooark.Exceptions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
