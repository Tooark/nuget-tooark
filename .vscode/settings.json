{
  // A suíte roda pelo Microsoft.Testing.Platform (ver Tooark.Tests.csproj e global.json). O Test Explorer do
  // C# Dev Kit descobre e executa testes nesse modo com a opção abaixo. A configuração antiga da extensão
  // dotnet-test-explorer passava propriedades do coverlet.msbuild, que não coletam mais nada no MTP, e foi
  // removida; a cobertura fica com a tarefa "generate coverage report" em tasks.json.
  "dotnet.testWindow.useTestingPlatformProtocol": true,
  "dotnet.defaultSolution": "Tooark.slnx",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  }
}
