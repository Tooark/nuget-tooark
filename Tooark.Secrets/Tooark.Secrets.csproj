<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Tooark.Secrets</PackageId>
    <Title>Tooark.Secrets</Title>
    <Authors>Paulo Sergio de Freitas Junior</Authors>
    <PackageTags>tooark, toolkit, secrets, vault, configuration, secret manager, parameter store, .NET</PackageTags>
    <Summary>Secret and parameter store abstractions for .NET projects.</Summary>
    <PackageDescription>Package with the secret store abstractions shared by the Tooark secrets providers: the configuration source that loads secrets and parameters into IConfiguration, and the ISecretService with cache for reads at runtime.</PackageDescription>
    <Description>Library with the provider-independent secrets contract, without any cloud SDK. The providers live in Tooark.Secrets.Aws, Tooark.Secrets.Gcp and Tooark.Secrets.Vault (HashiCorp Vault and OpenBao).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tooark.Exceptions\Tooark.Exceptions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
