# ==============================================================================
# Tooark — CODEOWNERS
# ==============================================================================
# GitHub uses this file to auto-request reviews from the right owner.
# Rules are matched top-to-bottom; the LAST matching rule wins per file.
#
# NOTE: uses the maintainer's personal handle (@paulosfjunior). Swap to a
# @Tooark/... team once the org has 2+ reviewers.
# ==============================================================================

# Global default — anything not matched by a later rule.
*                                   @paulosfjunior

# Governance, legal and licensing.
/LICENSE                            @paulosfjunior
/CODE_OF_CONDUCT.md                 @paulosfjunior
/SECURITY.md                        @paulosfjunior
/SUPPORT.md                         @paulosfjunior
/CONTRIBUTING.md                    @paulosfjunior

# CI/CD and GitHub configuration (supply-chain / release sensitive).
/.github/                           @paulosfjunior
/.github/workflows/                 @paulosfjunior
/.github/CODEOWNERS                 @paulosfjunior

# Versioning and dependency pins (drive every release and every consumer's
# dependency graph).
/Directory.Build.props              @paulosfjunior
/Directory.Packages.props           @paulosfjunior
/global.json                        @paulosfjunior
/Notes/                             @paulosfjunior

# Security-sensitive packages: cryptography, JWT, OpenID Connect and the
# translations that carry their error messages.
/Tooark.Securities/                 @paulosfjunior
/Tooark.Securities.OpenId/          @paulosfjunior
/Tooark.Extensions/Resources/       @paulosfjunior

# Local tooling users copy into their own environment.
/scripts/                           @paulosfjunior
