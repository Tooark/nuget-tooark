<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Tooark.Storage.Aws</PackageId>
    <Title>Tooark.Storage.Aws</Title>
    <Authors>Paulo Sergio de Freitas Junior</Authors>
    <PackageTags>tooark, toolkit, storage, aws, s3, minio, signed url, presigned url, .NET</PackageTags>
    <Summary>Amazon S3 provider for the Tooark storage abstractions.</Summary>
    <PackageDescription>Package that implements the Tooark IStorageService on Amazon S3 and S3-compatible services (MinIO, LocalStack, Cloudflare R2), with presigned URLs for reading and writing.</PackageDescription>
    <Description>Library with the Amazon S3 provider of Tooark.Storage: upload, download, delete, metadata and presigned URLs, with credentials from the options or from the AWS default credential chain.</Description>
    <!--
      Pacote novo na v4.7.0: ainda não existe versão publicada para comparar a API. Remova esta linha depois da
      primeira publicação, para que o pacote passe a ser validado contra a baseline do Directory.Build.props.
    -->
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tooark.Storage\Tooark.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
