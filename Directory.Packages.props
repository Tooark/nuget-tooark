<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Pacotes independentes da versão do runtime (mesma versão em todos os TFMs). Atualizados pelo Dependabot. -->
  <ItemGroup>
    <PackageVersion Include="AWSSDK.S3" Version="4.1.0" />
    <PackageVersion Include="AWSSDK.SecretsManager" Version="4.1.1" />
    <PackageVersion Include="AWSSDK.SimpleSystemsManagement" Version="4.1.1" />
    <PackageVersion Include="Google.Cloud.ParameterManager.V1" Version="1.1.0" />
    <PackageVersion Include="Google.Cloud.SecretManager.V1" Version="3.0.0" />
    <PackageVersion Include="Google.Cloud.Storage.V1" Version="5.0.0" />
    <PackageVersion Include="HtmlSanitizer" Version="10.0.1120" />
    <PackageVersion Include="Microsoft.AspNetCore.Http" Version="2.3.14" />
    <!--
      Dependência transitiva do Microsoft.AspNetCore.Http, fixada aqui porque o nuspec dele aceita a 2.3.13, que
      carrega a CVE-2026-118750 (negação de serviço). Com o pin transitivo habilitado, a versão entra no nuspec do
      Tooark.Utils e o consumidor resolve a corrigida. Suba junto com o Microsoft.AspNetCore.Http.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="2.3.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="OpenTelemetry" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <!--
      Só existe em pré-lançamento: o projeto OpenTelemetry nunca publicou uma versão estável desta
      instrumentação. Fica no rc da mesma linha dos demais pacotes OpenTelemetry e gera o aviso NU5104 no
      pack (liberado no Directory.Build.props). Ao subir a linha do OpenTelemetry, suba este junto.
    -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.Process" Version="1.21.0-rc.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageVersion Include="ReportGenerator" Version="5.5.12" />
    <PackageVersion Include="System.IO.Abstractions" Version="22.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <!--
    Pacotes ATRELADOS à versão do runtime — linha 10.0.x (LTS), a do único alvo (net10.0).
    Manutenção: suba os pacotes deste grupo juntos, a cada servicing do .NET, sempre dentro da linha 10.0.x. O
    Dependabot propõe os patches; a troca de major (11.x) só acompanha a troca do alvo, em uma versão major do
    Tooark, e por isso fica ignorada no .github/dependabot.yml.
  -->
  <ItemGroup>
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
  </ItemGroup>
</Project>
